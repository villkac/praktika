<Window x:Class="TaskManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет задач"
        Height="500" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#FFFCE4EC">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">

            <TextBlock Text="Название задачи"/>

            <TextBox x:Name="txtTaskName"
                     Height="28"
                     Margin="0,0,0,8"/>

            <TextBlock Text="Описание задачи"/>

            <TextBox x:Name="txtDescription"
                     Height="50"/>

        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">

            <Button Content="Добавить"
                    Width="100"
                    Height="30"
                    Margin="0,0,8,0"
                    Background="#FFF8BBD0"
                    Click="Add_Click"/>

            <Button Content="Изменить"
                    Width="100"
                    Height="30"
                    Margin="0,0,8,0"
                    Background="#FFF8BBD0"
                    Click="Update_Click"/>

            <Button Content="Удалить"
                    Width="100"
                    Height="30"
                    Margin="0,0,8,0"
                    Background="#FFF8BBD0"
                    Click="Delete_Click"/>

            <Button Content="Очистить"
                    Width="100"
                    Height="30"
                    Background="#FFF8BBD0"
                    Click="ClearFields_Click"/>

        </WrapPanel>

        <DataGrid x:Name="dgTasks"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  SelectionChanged="dgTasks_SelectionChanged">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="50"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding TaskName}"
                                    Width="*"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Description}"
                                    Width="2*"
                                    IsReadOnly="True"/>

                <DataGridTemplateColumn Header="Выполнена"
                                        Width="100">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      Click="TaskStatus_Click"/>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Window>