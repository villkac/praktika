<Window x:Class="EmployeeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет сотрудников"
        Height="500" Width="700"
        Background="#FFFFD6"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="ФИО" Margin="0,0,0,4"/>
                <TextBox x:Name="txtFullName"
                         Width="220" Height="28"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Должность" Margin="0,0,0,4"/>
                <TextBox x:Name="txtPosition"
                         Width="180" Height="28"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button Content="Добавить" Width="100" Height="30"
                    Margin="0,0,8,0" Background="#FFFFB366"
                    Click="Add_Click"/>

            <Button Content="Изменить" Width="100" Height="30"
                    Margin="0,0,8,0" Background="#FFFFB366"
                    Click="Update_Click"/>

            <Button Content="Удалить" Width="100" Height="30"
                    Margin="0,0,8,0" Background="#FFFFB366"
                    Click="Delete_Click"/>

            <Button Content="Очистить" Width="100" Height="30"
                    Background="#FFFFB366"
                    Click="ClearFields_Click"/>
        </WrapPanel>

        <DataGrid x:Name="dgEmployees"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionChanged="dgEmployees_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}" Width="60"/>

                <DataGridTextColumn Header="ФИО"
                                    Binding="{Binding FullName}" Width="2*"/>

                <DataGridTextColumn Header="Должность"
                                    Binding="{Binding Position}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</Window>