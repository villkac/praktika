<Window x:Class="PasswordManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passwords" Height="640" Width="980" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Passwords" DockPanel.Dock="Right" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource PinkBrush}" VerticalAlignment="Center"/>
            <Button Content="Выйти" Style="{StaticResource GrayButton}" DockPanel.Dock="Right"
                    Margin="0,0,16,0" Padding="14,5" Click="BtnLogout_Click"/>
            <TextBlock x:Name="txtUser" Text="Мои пароли" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GrayDarkBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock Text="Поиск по сервису или логину" DockPanel.Dock="Top"
                               Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtSearch" DockPanel.Dock="Top" Margin="0,0,0,10"
                             TextChanged="TxtSearch_TextChanged"/>

                    <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource GrayLightBrush}"
                              BorderThickness="0" Background="White"
                              SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Сервис" Binding="{Binding ServiceName}" Width="*"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                            <DataGridTextColumn Header="Пароль" Binding="{Binding Pass}" Width="100"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Правая карточка: данные записи и кнопки -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Данные записи" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource GrayDarkBrush}" Margin="0,0,0,10"/>

                    <TextBlock Text="Сервис (название)" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtService" Margin="0,0,0,8"/>

                    <TextBlock Text="Логин" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtEntryLogin" Margin="0,0,0,8"/>

                    <TextBlock Text="Пароль" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox x:Name="pwdEntry" Margin="0,0,0,8"/>

                    <TextBlock Text="Категория" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="cmbCategory" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,8" Padding="6"/>

                    <TextBlock Text="Описание" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtNotes" Height="50" AcceptsReturn="True" TextWrapping="Wrap"
                             Margin="0,0,0,12"/>

                    <UniformGrid Columns="2">
                        <Button Content="Добавить" Margin="0,0,3,6" Click="BtnAdd_Click"/>
                        <Button Content="Изменить" Margin="3,0,0,6" Click="BtnEdit_Click"/>
                        <Button Content="Удалить" Style="{StaticResource DarkButton}"
                                Margin="0,0,3,6" Click="BtnDelete_Click"/>
                        <Button Content="Очистить" Style="{StaticResource GrayButton}"
                                Margin="3,0,0,6" Click="BtnClear_Click"/>
                        <Button Content="Показать пароль" Style="{StaticResource GrayButton}"
                                Margin="0,0,3,0" Click="BtnShow_Click"/>
                        <Button Content="Копировать" Style="{StaticResource GrayButton}"
                                Margin="3,0,0,0" Click="BtnCopy_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
