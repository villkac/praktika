<Window x:Class="PasswordManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passwords — вход" Height="540" Width="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">   

    <Grid>       
        <TextBlock Text="Passwords" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource PinkBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0"/>

        <Border Style="{StaticResource CardStyle}" Width="340"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="txtTitle" Text="Вход" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource GrayDarkBrush}"/>
                <TextBlock x:Name="txtSubtitle" Text="Войдите, чтобы открыть свои пароли"
                           Foreground="{StaticResource GrayBrush}" Margin="0,2,0,16"/>

                <TextBlock Text="Логин" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtLogin" Margin="0,0,0,10"/>

                <TextBlock Text="Пароль" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="pwdLogin" Margin="0,0,0,10"/>

                <StackPanel x:Name="confirmPanel" Visibility="Collapsed">
                    <TextBlock Text="Подтвердите пароль" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox x:Name="pwdConfirm" Margin="0,0,0,10"/>
                </StackPanel>

                <Button x:Name="btnMain" Content="Войти" IsDefault="True"
                        Margin="0,6,0,8" Click="BtnMain_Click"/>
                <Button x:Name="btnSwitch" Content="Нет аккаунта? Регистрация"
                        Style="{StaticResource GrayButton}" Click="BtnSwitch_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
