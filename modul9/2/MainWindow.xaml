<Window x:Class="ProjectManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление проектами"
        Height="700"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFFCE4EC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFF8BBD0"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Управление проектами"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FF6D3B50"/>

                <TextBlock Text="Проекты, задачи, сотрудники и отчёты"
                           FontSize="14"
                           Margin="0,5,0,0"
                           Foreground="#FF79515F"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1"
                    FontSize="14"
                    Background="White">

            <!-- ПРОЕКТЫ -->
            <TabItem Header="Проекты">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button Content="Добавить" Click="AddProject_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>

                        <Button Content="Редактировать" Click="EditProject_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>

                        <Button Content="Удалить" Click="DeleteProject_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>

                        <Button Content="Обновить" Click="LoadProjects_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>
                    </WrapPanel>

                    <DataGrid x:Name="dgvProjects"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnWidth="*"
                              CanUserResizeColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="Название проекта" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate}"/>
                            <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate}"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ЗАДАЧИ -->
            <TabItem Header="Задачи">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button Content="Добавить" Click="AddTask_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>

                        <Button Content="Редактировать" Click="EditTask_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>

                        <Button Content="Удалить" Click="DeleteTask_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>

                        <Button Content="Назначить сотрудника" Click="AssignTask_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>

                        <Button Content="Обновить" Click="LoadTasks_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>
                    </WrapPanel>

                    <DataGrid x:Name="dgvTasks"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnWidth="*"
                              CanUserResizeColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="Проект" Binding="{Binding ProjectName}" Width="*"/>
                            <DataGridTextColumn Header="Название задачи" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate}"/>
                            <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate}"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                            <DataGridTextColumn Header="Выполнение, %" Binding="{Binding Progress}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- СОТРУДНИКИ -->
            <TabItem Header="Сотрудники">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button Content="Добавить" Click="AddEmployee_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>

                        <Button Content="Редактировать" Click="EditEmployee_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>

                        <Button Content="Удалить" Click="DeleteEmployee_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>

                        <Button Content="Обновить" Click="LoadEmployees_Click"
                                Background="#FFF8BBD0" Foreground="#FF6D3B50"
                                Padding="14,8" Margin="0,0,8,5"
                                BorderThickness="0" Cursor="Hand"/>
                    </WrapPanel>

                    <DataGrid x:Name="dgvEmployees"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnWidth="*"
                              CanUserResizeColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="ФИО сотрудника" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="*"/>
                            <DataGridTextColumn Header="Электронная почта" Binding="{Binding Email}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ОТЧЁТЫ -->
            <TabItem Header="Отчёты">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Отчёт о состоянии проектов и задач"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <WrapPanel>
                            <Button Content="Сформировать отчёт"
                                    Click="GenerateReport_Click"
                                    Background="#FFF8BBD0"
                                    Foreground="#FF6D3B50"
                                    Padding="14,8"
                                    Margin="0,0,8,5"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </WrapPanel>
                    </StackPanel>

                    <DataGrid x:Name="dgvReports"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnWidth="*"
                              CanUserResizeColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="Название проекта" Binding="{Binding ProjectName}" Width="2*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                            <DataGridTextColumn Header="Всего задач" Binding="{Binding TotalTasks}"/>
                            <DataGridTextColumn Header="Завершено задач" Binding="{Binding CompletedTasks}"/>
                            <DataGridTextColumn Header="Среднее выполнение, %" Binding="{Binding AverageProgress}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
