<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление задачами"
        Height="750" Width="1200"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F2">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Управление задачами"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#804D68"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E8D5DF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Название задачи:"
                           VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="txtName"
                         Grid.Row="0" Grid.Column="1"
                         Margin="5" Padding="5"/>

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Приоритет:"
                           VerticalAlignment="Center" Margin="5"/>
                <ComboBox x:Name="cmbPriority"
                          Grid.Row="0" Grid.Column="3"
                          Margin="5" Padding="5"
                          SelectedIndex="1">
                    <ComboBoxItem Content="Низкий"/>
                    <ComboBoxItem Content="Средний"/>
                    <ComboBoxItem Content="Высокий"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Описание:"
                           VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="txtDescription"
                         Grid.Row="1" Grid.Column="1"
                         Margin="5" Padding="5"
                         Height="55"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>

                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="Срок выполнения:"
                           VerticalAlignment="Center" Margin="5"/>
                <DatePicker x:Name="dpDueDate"
                            Grid.Row="1" Grid.Column="3"
                            Margin="5" Padding="5"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Статус:"
                           VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox x:Name="cmbStatus"
                          Grid.Row="2" Grid.Column="1"
                          Margin="5" Padding="5"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Не начата"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Завершена"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="2"
                           Text="Выполнение, %:"
                           VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtProgress"
                         Grid.Row="2" Grid.Column="3"
                         Margin="5" Padding="5"
                         Text="0"/>
            </Grid>
        </Border>

        <DataGrid x:Name="dgvTasks"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  SelectionChanged="dgvTasks_SelectionChanged"
                  Background="White"
                  BorderBrush="#E8D5DF"
                  RowBackground="White"
                  AlternatingRowBackground="#FFF0F6"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>
                <DataGridTextColumn Header="№"
                                    Binding="{Binding Id}"
                                    Width="45"/>
                <DataGridTextColumn Header="Название задачи"
                                    Binding="{Binding Name}"
                                    Width="*"/>
                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Description}"
                                    Width="1.5*"/>
                <DataGridTextColumn Header="Приоритет"
                                    Binding="{Binding Priority}"
                                    Width="100"/>
                <DataGridTextColumn Header="Дата создания"
                                    Binding="{Binding CreatedDate}"
                                    Width="110"/>
                <DataGridTextColumn Header="Срок выполнения"
                                    Binding="{Binding DueDate}"
                                    Width="120"/>
                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="110"/>
                <DataGridTextColumn Header="Выполнение, %"
                                    Binding="{Binding Progress}"
                                    Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="3"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0">

            <Button Content="Добавить"
                    Click="AddTask_Click"
                    Margin="5" Padding="18,10"
                    Background="#D9A6BF"/>

            <Button Content="Изменить"
                    Click="EditTask_Click"
                    Margin="5" Padding="18,10"
                    Background="#E8C7D7"/>

            <Button Content="Удалить"
                    Click="DeleteTask_Click"
                    Margin="5" Padding="18,10"
                    Background="#E8C7D7"/>

            <Button Content="Очистить поля"
                    Click="ClearFields_Click"
                    Margin="5" Padding="18,10"
                    Background="#F0DFE7"/>

            <Button Content="Обновить"
                    Click="Refresh_Click"
                    Margin="5" Padding="18,10"
                    Background="#F0DFE7"/>
        </WrapPanel>
    </Grid>
</Window>
