<Window x:Class="_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр изображений"
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кнопки в один ряд -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button Content="Открыть"
                    Width="120" Height="38"
                    Margin="0,0,8,0"
                    Click="OpenImage_Click"/>

            <Button Content="Увеличить"
                    Width="120" Height="38"
                    Margin="0,0,8,0"
                    Click="ZoomIn_Click"/>

            <Button Content="Уменьшить"
                    Width="120" Height="38"
                    Margin="0,0,8,0"
                    Click="ZoomOut_Click"/>

            <Button Content="Исходный размер"
                    Width="150" Height="38"
                    Click="OriginalSize_Click"/>
        </StackPanel>

        <!-- Область просмотра изображения -->
        <Border Grid.Row="1"
                BorderBrush="Gray"
                BorderThickness="1"
                Background="#FFF4F4F4">

            <ScrollViewer x:Name="imageScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                <Image x:Name="imageView"
                       Stretch="Fill"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
