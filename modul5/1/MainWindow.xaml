<Window x:Class="_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приложение для рисования" Height="650" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Линия" Width="100" Height="36"
                    Margin="0,0,8,0" Click="SelectTool_Click"/>
            <Button Content="Круг" Width="100" Height="36"
                    Margin="0,0,8,0" Click="SelectTool_Click"/>
            <Button Content="Квадрат" Width="100" Height="36"
                    Margin="0,0,8,0" Click="SelectTool_Click"/>
            <Button Content="Очистить" Width="110" Height="36"
                    Click="Clear_Click"/>
        </StackPanel>

        <Canvas x:Name="canvas" Grid.Row="1" Background="White"
                ClipToBounds="True"
                MouseLeftButtonDown="Down"
                MouseMove="Move"
                MouseLeftButtonUp="Up"/>
    </Grid>
</Window>
