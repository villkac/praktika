<Window x:Class="_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="480" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#FFFFF0F5">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="txtDisplay" Grid.Row="0" Grid.ColumnSpan="4"
                 Margin="4" Text="0" FontSize="24" FontWeight="Bold"
                 IsReadOnly="True" TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 Background="#FFFFFAFC" Foreground="#FF552337"
                 BorderBrush="#FFE89EB8"/>

        <Button Content="7" Grid.Row="1" Grid.Column="0"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFFADCE7"/>
        <Button Content="8" Grid.Row="1" Grid.Column="1"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFFADCE7"/>
        <Button Content="9" Grid.Row="1" Grid.Column="2"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFFADCE7"/>
        <Button Content="/" Grid.Row="1" Grid.Column="3"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFF2B5CB"/>

        <Button Content="4" Grid.Row="2" Grid.Column="0"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFFADCE7"/>
        <Button Content="5" Grid.Row="2" Grid.Column="1"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFFADCE7"/>
        <Button Content="6" Grid.Row="2" Grid.Column="2"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFFADCE7"/>
        <Button Content="*" Grid.Row="2" Grid.Column="3"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFF2B5CB"/>

        <Button Content="1" Grid.Row="3" Grid.Column="0"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFFADCE7"/>
        <Button Content="2" Grid.Row="3" Grid.Column="1"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFFADCE7"/>
        <Button Content="3" Grid.Row="3" Grid.Column="2"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFFADCE7"/>
        <Button Content="-" Grid.Row="3" Grid.Column="3"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFF2B5CB"/>

        <Button Content="C" Grid.Row="4" Grid.Column="0"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFF2B5CB"/>
        <Button Content="0" Grid.Row="4" Grid.Column="1"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFFADCE7"/>
        <Button x:Name="btnComma" Content="," Grid.Row="4" Grid.Column="2"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFFADCE7"/>
        <Button Content="+" Grid.Row="4" Grid.Column="3"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="16" Background="#FFF2B5CB"/>

        <Button Content="=" Grid.Row="5" Grid.ColumnSpan="4"
                Click="CalculatorButton_Click" Margin="4"
                FontSize="18" FontWeight="Bold"
                Background="#FFECA0BE" Foreground="#FF552337"/>
    </Grid>
</Window>